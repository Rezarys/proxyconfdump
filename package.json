  "keywords": [
    "nginx-proxy-manager",
    "sqlite",
    "export",
    "backup",
    "reverse-proxy",
    "self-hosted",
    "cli"
  ],
  "license": "MIT",
  "author": "Younes Z.",
  "type": "module",
  "bin": {
    "proxyconfdump": "bin/proxyconfdump.js"
  },
  "exports": {
    ".": "./src/export.js"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "test": "node --test test/"
  },
  "repository": "github:Rezarys/proxyconfdump",
  "homepage": "https://github.com/Rezarys/proxyconfdump",
  "bugs": "https://github.com/Rezarys/proxyconfdump/issues"
}
